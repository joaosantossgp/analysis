# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Data files (large CSVs, ZIPs, DB)
data/input/**/*.csv
data/input/**/*.zip
data/input/raw/
data/input/processed/
data/db/
data/*.csv
data/*.xlsx
data/legacy_archives/
data/metadata/b3_companies_cache.json

# SQLite sidecars anywhere in the tree (WAL/SHM from runtime opens)
*.db-wal
*.db-shm

# Local environment
.env
.env.local
.env.*.local

# Output
output/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Claude internal
.claude/plans/
.claude/settings.local.json
.claude/worktrees/
.agents/

# Reference sites (large HTML snapshots)
docs/vendor/sites_ex/

# Logs
*.log
!.ai-activity.log
logs/

# Browser test artifacts
.playwright-cli/

# Local caches and reports
data/cache/
perf-guardrail-report.local.json

# Build-time portable Node binary (copied from system Node by build_desktop.ps1)
desktop/node_portable/

# Repomix merged-repo dump (large generated artifact)
repomix-output.*
