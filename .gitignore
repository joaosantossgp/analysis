# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
release/
.venv/
venv/

# Data files (large CSVs, ZIPs, DB)
data/input/**/*.csv
data/input/**/*.zip
data/input/raw/
data/input/processed/
data/db/
data/*.csv
data/*.xlsx
data/*.db
data/raw/
data/legacy_archives/
data/metadata/b3_companies_cache.json

# Desktop runtime state (written at runtime, not source)
data/onboarding_state.json
data/refresh_jobs.json
data/runtime.lock

# Generated market-cap snapshots (runtime-produced, not source)
data/metadata/b3_market_cap_universe_snapshot.csv

# SQLite sidecars anywhere in the tree (WAL/SHM from runtime opens)
*.db-wal
*.db-shm

# Local environment
.env
.env.local
.env.*.local

# Output
output/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Claude internal
.claude/plans/
.claude/settings.local.json
.claude/worktrees/
.agents/

# Reference sites (large HTML snapshots)
docs/vendor/sites_ex/

# Logs
*.log
!.ai-activity.log
logs/

# Browser test artifacts
.playwright-cli/

# Local caches and reports
data/cache/
perf-guardrail-report.local.json

# Build-time portable Node binary (copied from system Node by build_desktop.ps1)
desktop/node_portable/

# Repomix merged-repo dump (large generated artifact)
repomix-output.*

# Release validation directories
release_validation_*/

# Historical archive — all local-only, never committed (root-only)
/archive/

# Local scratch space — drafts, experimental scripts, generated workbooks,
# downloaded release artifacts for verification. Never committed.
/scratch/

# Playwright MCP local trace/cache
/.playwright-mcp/

# Packaged Windows release artifacts. The canonical distribution channel is
# the GitHub Release, not the repo tree. Local copies stay out of git.
/CVMAnalytics-windows*.zip
/CVMAnalytics-windows*.zip.sha256

# Mangled absolute-path folders from bad shell commands (Windows)
/C:Users*

