{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Desktop App (pywebview)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "desktop.app", "--dev"]
    },
    {
      "name": "FastAPI (dev)",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["apps.api.app.main:app", "--reload"],
      "port": 8000
    },
    {
      "name": "Vite Desktop SPA",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/desktop-web"],
      "port": 5173
    },
    {
      "name": "Vite Desktop SPA (mock)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mock", "--prefix", "apps/desktop-web"],
      "port": 5173
    }
  ]
}
