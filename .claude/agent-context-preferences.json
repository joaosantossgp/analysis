{
  "metadata": {
    "version": "2.1",
    "purpose": "Hints for agent context initialization to reduce token consumption"
  },
  "governance_mode": "compact",
  "preferred_refs": {
    "operational_rules": "AGENTS.md",
    "business_rules": "docs/CONTEXT.md",
    "active_reference_docs": "docs/reference/",
    "ADRs": "docs/decisions/",
    "project_status": "docs/STATUS.md",
    "issue_tracker": "docs/agents/issue-tracker.md"
  },
  "exclude_from_context": [
    ".workflow/.scratchpad/",
    ".claude/worktrees/",
    ".playwright-cli/",
    ".playwright-mcp/",
    ".orchestration/",
    "docs/vendor/",
    "docs/archive/",
    "docs/releases/",
    "build/",
    "dist/",
    "output/",
    "tmp/",
    "scratch/",
    ".pytest_cache/",
    "node_modules/",
    "data/db/",
    "data/dev-runtime/",
    "data/raw/"
  ],
  "context_optimization": {
    "default_mode": "Fast Mode per AGENTS.md — load AGENTS.md once, on demand for CONTEXT.md / reference docs."
  }
}
