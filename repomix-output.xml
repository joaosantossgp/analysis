    def test_conflicting_duplicates_flagged(self, scraper):
        df = self._wide([
            {'LINE_ID_BASE': 'A', 'CD_CONTA': '1', 'DS_CONTA': 'Ativo', '2024': 100.0, 'QA_CONFLICT': False},
            {'LINE_ID_BASE': 'A', 'CD_CONTA': '1', 'DS_CONTA': 'Ativo', '2024': 999.0, 'QA_CONFLICT': False},
