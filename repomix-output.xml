def _make_zip_bytes(file_entries: dict) -> bytes:
    """Helper: cria um ZIP em memória com os arquivos indicados."""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, 'w') as zf:
        for name, content in file_entries.items():
            zf.writestr(name, content)
    return buf.getvalue()


