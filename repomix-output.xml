    extractor = CVMFinancialExtractor(
        output_dir=OUTPUT_DIR,
        data_dir=DATA_DIR,
        report_type=REPORT_TYPE
    )
    
    # Run extraction
    extractor.run(
        company_names=[COMPANY_NAME],
        years=list(range(START_YEAR, END_YEAR + 1))
    )
