import { ArrowRightIcon, SearchIcon, XIcon } from "lucide-react";
import { useRef, useState, useTransition } from "react";
import { useRouter } from "next/navigation";

import { useCompanySuggestions } from "@/components/shared/use-company-suggestions";
import { useComboboxNavigation } from "@/components/shared/use-combobox-navigation";
import { buttonVariants } from "@/components/ui/button";
import { type CompanySuggestionItem } from "@/lib/api";
import { getSectorColor, UNCLASSIFIED_SECTOR_LABEL } from "@/lib/constants";
import { track } from "@/lib/track";
import { cn } from "@/lib/utils";

const QUICK_CHIPS = [
  "PETROBRAS",
  "VALE3",
  "ITAUB4",
  "BBDC4",
  "Financeiro",
  "Petroleo e Gas",
];

export function CompanySearchHero() {
  const router = useRouter();
  const inputRef = useRef<HTMLInputElement>(null);
  const [query, setQuery] = useState("");
  const [focused, setFocused] = useState(false);
  const [isPending, startTransition] = useTransition();

  const {
    suggestions,
    loading: loadingSuggestions,
    error: suggestionFetchError,
  } = useCompanySuggestions(query);

  const suggestionError = suggestionFetchError
    ? `${suggestionFetchError} Pressione Enter para abrir o diretorio completo.`
    : null;

  function navigateToCompany(item: CompanySuggestionItem) {
    track("home_suggestion_selected", {
      cd_cvm: item.cd_cvm,
      company_name: item.company_name,
    });
    startTransition(() => router.push(`/empresas/${item.cd_cvm}`));
  }

  function submit() {
    const q = query.trim();
    track("home_search_submitted", { query: q });
    startTransition(() =>
      router.push(q ? `/empresas?busca=${encodeURIComponent(q)}` : "/empresas"),
    );
  }

  const {
    activeIndex: activeSuggestionIndex,
    setActiveIndex: setActiveSuggestionIndex,
    handleKeyDown: handleInputKeyDown,
  } = useComboboxNavigation({
    items: suggestions,
    onSelect: navigateToCompany,
    onSubmit: submit,
    onEscape: () => setFocused(false),
  });

  const showDropdown =
    focused && (loadingSuggestions || suggestions.length > 0 || suggestionError !== null);

  return (
    <div className="w-full max-w-[680px] mx-auto space-y-6 text-center">
      <div className="space-y-4">
        <h1 className="font-heading text-[clamp(2.5rem,5.5vw,4.25rem)] leading-[1.02] tracking-[-0.045em] text-foreground">
          Analise financeira
          <br />
          <span className="text-muted-foreground italic font-normal">
            de quem esta na bolsa.
          </span>
        </h1>
        <p className="max-w-[560px] mx-auto text-lg leading-[1.55] text-muted-foreground">
          Pesquise qualquer companhia aberta brasileira. Leia DRE, balanco e KPIs
          com 10+ anos de historico, direto da CVM.
        </p>
      </div>

      <div className="relative text-left">
        <div
          onClick={() => inputRef.current?.focus()}
          className={cn(
            "flex items-center gap-3 bg-card border transition-all duration-200 cursor-text px-5 py-2 pr-2",
            showDropdown ? "rounded-[1.25rem_1.25rem_0_0]" : "rounded-[1.25rem]",
            focused
              ? "border-ring/50 shadow-[0_0_0_4px_color-mix(in_oklch,var(--ring)_15%,transparent),0_20px_60px_-40px_rgba(16,30,24,0.25)]"
              : "border-border/70 shadow-[0_18px_50px_-40px_rgba(16,30,24,0.22)]",
          )}
        >
          <SearchIcon className="size-[1.375rem] shrink-0 text-muted-foreground" />
          <input
            ref={inputRef}
            value={query}
            onChange={(event) => setQuery(event.target.value)}
            onFocus={() => setFocused(true)}
            onBlur={() => setTimeout(() => setFocused(false), 150)}
            onKeyDown={handleInputKeyDown}
            placeholder="Petrobras, VALE3, setor financeiro..."
            className="flex-1 border-none bg-transparent py-[0.85rem] text-[1.125rem] text-foreground outline-none placeholder:text-muted-foreground"
            aria-label="Buscar empresa"
            role="combobox"
            aria-expanded={showDropdown}
            aria-controls="home-company-suggestions"
            aria-activedescendant={
              activeSuggestionIndex >= 0
                ? `home-company-suggestion-${suggestions[activeSuggestionIndex]?.cd_cvm ?? "none"}`
                : undefined
            }
          />
          {query ? (
            <button
              type="button"
              onClick={() => {
                setQuery("");
                inputRef.current?.focus();
              }}
              className="flex size-8 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground mr-1"
              aria-label="Limpar busca"
            >
              <XIcon className="size-4" />
            </button>
          ) : null}
          <button
            type="button"
            onClick={submit}
            disabled={isPending}
            className={cn(buttonVariants({ size: "lg" }), "rounded-full px-5 shrink-0")}
          >
            Buscar
            <ArrowRightIcon className="size-4" />
          </button>
        </div>

        {showDropdown ? (
          <div
            id="home-company-suggestions"
            role="listbox"
            className="absolute inset-x-0 top-full z-20 overflow-hidden rounded-[0_0_1.25rem_1.25rem] border border-t-0 border-ring/50 bg-card shadow-[0_20px_60px_-30px_rgba(16,30,24,0.25)]"
          >
            <div className="border-t border-border bg-muted/30 px-5 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
              {loadingSuggestions
                ? "Buscando..."
                : suggestionError
                  ? "Busca com fallback"
                  : `${suggestions.length} resultado${suggestions.length !== 1 ? "s" : ""}`}
            </div>

            {suggestionError ? (
              <div className="border-t border-border/50 px-5 py-3 text-sm text-muted-foreground">
                {suggestionError}
              </div>
            ) : null}

            {suggestions.map((item, index) => {
              const sectorName = item.gics_sector ?? null;
              const color = getSectorColor(sectorName);
              const initials = (item.ticker_b3 ?? item.company_name).slice(0, 2).toUpperCase();
              return (
                <button
                  key={item.cd_cvm}
                  id={`home-company-suggestion-${item.cd_cvm}`}
                  role="option"
                  aria-selected={activeSuggestionIndex === index}
                  type="button"
                  onMouseDown={() => navigateToCompany(item)}
                  onMouseEnter={() => setActiveSuggestionIndex(index)}
                  className={cn(
                    "flex w-full items-center gap-4 border-t border-border/50 px-5 py-3.5 text-left transition-colors hover:bg-accent/60",
                    activeSuggestionIndex === index && "bg-accent/60",
                  )}
                >
                  <div
                    className="flex size-10 shrink-0 items-center justify-center rounded-[10px] font-heading text-sm font-semibold"
                    style={{
                      background: `color-mix(in oklch, ${color} 12%, transparent)`,
                      border: `1px solid color-mix(in oklch, ${color} 25%, transparent)`,
                      color,
                    }}
                  >
                    {initials}
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="font-semibold text-sm text-foreground">{item.company_name}</span>
                      {item.ticker_b3 ? (
                        <span
                          className="font-mono text-xs font-medium px-1.5 py-0.5 rounded-[0.35rem]"
                          style={{
                            background: `color-mix(in oklch, ${color} 12%, transparent)`,
                            border: `1px solid color-mix(in oklch, ${color} 25%, transparent)`,
                            color,
                          }}
                        >
                          {item.ticker_b3}
                        </span>
                      ) : null}
                    </div>
                    <p className="text-sm text-muted-foreground mt-0.5">
                      {sectorName ?? UNCLASSIFIED_SECTOR_LABEL}
                    </p>
                    <p className="text-xs text-muted-foreground mt-1">
                      Abra a pagina; se faltar historico local, solicite dados on-demand.
                    </p>
                  </div>
                  <div className="text-right shrink-0">
                    <p className="text-xs uppercase tracking-[0.15em] text-muted-foreground">
                      CVM
                    </p>
                    <p className="mt-0.5 font-mono text-sm font-medium text-foreground tabular-nums">
                      {item.cd_cvm}
                    </p>
                  </div>
                </button>
              );
            })}
          </div>
        ) : null}
      </div>

      <div className="flex flex-wrap justify-center items-center gap-2">
        <span className="text-sm text-muted-foreground">Tente:</span>
        {QUICK_CHIPS.map((chip) => (
          <button
            key={chip}
            type="button"
            onClick={() => {
              setQuery(chip);
              setTimeout(() => inputRef.current?.focus(), 0);
            }}
            className="rounded-full border border-border bg-card px-3 py-1 font-mono text-xs text-muted-foreground transition-colors hover:border-primary/35 hover:text-primary"
          >
            {chip}
          </button>
        ))}
      </div>
    </div>
  );
}
</file>

<file path="apps/web/tests/update-base.test.ts">
import test from "node:test";
import assert from "node:assert/strict";

import {
  fetchBaseHealth,
  fetchBatchRefresh,
  fetchBatchJobs,
  fetchBatchJobStatus,
  cancelBatchJob,
  resolveBatchRefreshCvmRange,
} from "../lib/api.ts";
import {
  buildBaseHealthSummary,
  buildHistoryRows,
  buildUpdateModeEstimates,
  computeRefreshProgress,
  getStageProgressFloor,
  getHistoryState,
} from "../lib/update-base-admin.ts";
import {
  bridgeRequestBatchRefresh,
  bridgeFetchBatchStatus,
  bridgeCancelRefresh,
} from "../lib/desktop-bridge.ts";

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

type FetchMock = typeof globalThis.fetch;

function withFetchMock(mock: FetchMock) {
  const originalFetch = globalThis.fetch;
  globalThis.fetch = mock;
  return () => {
    globalThis.fetch = originalFetch;
  };
}

type PyApi = NonNullable<NonNullable<typeof globalThis.window>["pywebview"]>["api"];

function withPywebview(api: Partial<PyApi>) {
  const win = globalThis as unknown as {
    window?: { pywebview?: { api: Partial<PyApi> } };
  };
  const prev = win.window;
  win.window = { pywebview: { api } };
  return () => {
    win.window = prev;
  };
}

// ---------------------------------------------------------------------------
// base health / jobs loading
// ---------------------------------------------------------------------------

const baseHealthPayload = {
  generated_at: "2026-05-04T15:00:00",
  start_year: 2024,
  end_year: 2025,
  total_cells: 10,
  completed_cells: 7,
  missing_cells: 3,
  pct: 70,
  health_score: 78,
  health_status: "atencao",
  eta_hours: 1.5,
  throughput_per_hour: 2,
  throughput_confidence: "medium",
  per_year: [
    { year: 2024, total_companies: 5, completed: 4, missing: 1, pct: 80, eta_hours: 0.5 },
    { year: 2025, total_companies: 6, completed: 3, missing: 3, pct: 50, eta_hours: 1 },
  ],
  prioritized_companies: [],
  raw: {},
  total_companies: 6,
  companies_with_historical_data: 4,
  companies_without_historical_data: 2,
  companies_with_any_local_financial_report: 5,
  companies_partial_local: 1,
  companies_fully_updated: 2,
  companies_with_refresh_status_recorded: 5,
  companies_with_last_refresh_error: 0,
};

test("fetchBaseHealth tolerates legacy payloads without extended inventory counters", async () => {
  const legacy = { ...baseHealthPayload } as Record<string, unknown>;
  delete legacy.companies_with_any_local_financial_report;
  delete legacy.companies_partial_local;
  delete legacy.companies_fully_updated;
  delete legacy.companies_with_refresh_status_recorded;
  delete legacy.companies_with_last_refresh_error;

  const restore = withFetchMock((async (request: RequestInfo | URL): Promise<Response> => {
    void request;
    return new Response(JSON.stringify(legacy), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as FetchMock);

  try {
    const result = await fetchBaseHealth({ startYear: 2024, endYear: 2025 });
    assert.equal(result.companies_with_any_local_financial_report, 0);
    assert.equal(result.companies_partial_local, 0);
    assert.equal(result.companies_fully_updated, 0);
    assert.equal(result.companies_with_refresh_status_recorded, 0);
    assert.equal(result.companies_with_last_refresh_error, 0);
    assert.equal(result.total_companies, 6);
  } finally {
    restore();
  }
});

test("fetchBaseHealth (web) loads the same-origin base-health route with the real window", async () => {
  let capturedUrl = "";
  const restore = withFetchMock((async (input: RequestInfo | URL) => {
    capturedUrl = String(input);
    return new Response(JSON.stringify(baseHealthPayload), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as FetchMock);

  try {
    const result = await fetchBaseHealth({ startYear: 2024, endYear: 2025 });
    assert.ok(
      capturedUrl.endsWith("/api/base-health?start_year=2024&end_year=2025"),
      `unexpected url: ${capturedUrl}`,
    );
    assert.equal(result.missing_cells, 3);
  } finally {
    restore();
  }
});

test("fetchBatchJobs (web) distinguishes no active job with an empty real list", async () => {
  let capturedUrl = "";
  const restore = withFetchMock((async (input: RequestInfo | URL) => {
    capturedUrl = String(input);
    return new Response(JSON.stringify({ items: [] }), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as FetchMock);

  try {
    const result = await fetchBatchJobs();
    assert.ok(capturedUrl.endsWith("/api/refresh-jobs"), `unexpected url: ${capturedUrl}`);
    assert.deepEqual(result.items, []);
  } finally {
    restore();
  }
});

test("update-base summaries derive cards and mode estimates from health and filters", () => {
  const sectors = [
    { sector_name: "Energia", sector_slug: "energia", company_count: 2 },
    { sector_name: "Financeiro", sector_slug: "financeiro", company_count: 4 },
  ];

  const summary = buildBaseHealthSummary(baseHealthPayload);
  const estimates = buildUpdateModeEstimates({
    health: baseHealthPayload,
    sectors,
    selectedSectorSlug: "energia",
  });

  assert.equal(summary.totalCompanies, 6);
  assert.equal(summary.companiesWithHistoricalData, 4);
  assert.equal(summary.companiesWithoutHistoricalData, 2);
  assert.equal(summary.companiesWithAnyLocalFinancialReport, 5);
  assert.equal(summary.companiesFullyUpdated, 2);
  assert.equal(summary.completedCells, 7);
  assert.equal(summary.missingCells, 3);
  assert.equal(estimates.full.affected, 2);
  assert.match(estimates.full.description, /2 empresas no setor Energia/);
  assert.equal(estimates.missing.affected, 3);
  assert.match(estimates.missing.description, /3 lacunas na janela 2024-2025/);
  assert.equal(estimates.outdated.affected, null);
});

test("update-base history exposes explicit empty and terminal states", () => {
  assert.deepEqual(buildHistoryRows([]), []);
  assert.equal(
    getHistoryState({ jobsState: "available", activeJobCount: 0, historyCount: 0 }),
    "no_history_no_active_job",
  );

  const rows = buildHistoryRows([
    {
      job_id: "job-1",
      state: "success",
      mode: "missing",
      queued: 3,
      processed: 3,
      failures: 0,
      started_at: "2026-05-04T15:00:00",
      finished_at: "2026-05-04T15:02:05",
      log_lines: [],
    },
  ]);

  assert.equal(rows.length, 1);
  assert.equal(rows[0]?.typeLabel, "Faltantes");
  assert.equal(rows[0]?.status, "success");
  assert.equal(rows[0]?.duration, "2m 5s");
  assert.equal(
    getHistoryState({ jobsState: "available", activeJobCount: 1, historyCount: 0 }),
    "active_jobs_no_history",
  );
});

test("progress fallback uses stage floor when numeric progress stalls", () => {
  assert.equal(getStageProgressFloor("planning"), 8);
  assert.equal(getStageProgressFloor("persist_reports"), 82);
  assert.equal(getStageProgressFloor("unknown"), 0);

  assert.equal(
    computeRefreshProgress({ numericPct: 0, stageFloor: 35, isStalled: true }),
    35,
  );
  assert.equal(
    computeRefreshProgress({ numericPct: 42, stageFloor: 35, isStalled: false }),
    42,
  );
});

// ---------------------------------------------------------------------------
// fetchBatchRefresh — web mode
// ---------------------------------------------------------------------------

test("fetchBatchRefresh (web) posts to /api/refresh-batch and returns dispatch response", async () => {
  const dispatch = {
    status: "running",
    job_id: "abc123",
    queued: 5,
    message: "Refresh iniciado em background.",
    is_retry_allowed: false,
  };

  let capturedUrl = "";
  let capturedMethod = "";
  let capturedBody: unknown = null;

  const restore = withFetchMock((async (input: RequestInfo | URL, init?: RequestInit) => {
    capturedUrl = typeof input === "string" ? input : String(input);
    capturedMethod = init?.method ?? "GET";
    capturedBody = init?.body ? JSON.parse(String(init.body)) : null;
    return new Response(JSON.stringify(dispatch), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as FetchMock);

  try {
    const result = await fetchBatchRefresh({ mode: "missing" });
    assert.ok(capturedUrl.endsWith("/api/refresh-batch"), `unexpected url: ${capturedUrl}`);
    assert.equal(capturedMethod, "POST");
    assert.equal((capturedBody as { mode: string }).mode, "missing");
    assert.equal(result.status, "running");
    assert.equal(result.job_id, "abc123");
    assert.equal(result.queued, 5);
  } finally {
    restore();
  }
});

test("fetchBatchRefresh (web) passes canonical filters in the request body", async () => {
  let capturedBody: Record<string, unknown> = {};

  const restore = withFetchMock((async (_: RequestInfo | URL, init?: RequestInit) => {
    capturedBody = init?.body ? (JSON.parse(String(init.body)) as Record<string, unknown>) : {};
    return new Response(
      JSON.stringify({ status: "queued", job_id: "x", queued: 2, message: "ok", is_retry_allowed: false }),
      { status: 200, headers: { "content-type": "application/json" } },
    );
  }) as FetchMock);

  try {
    await fetchBatchRefresh({
      mode: "outdated",
      sectorSlug: "financeiro",
      statusFilter: "failed",
      cvmRange: { start: 100, end: 999 },
    });
    assert.equal(capturedBody.mode, "outdated");
    assert.equal(capturedBody.sector_slug, "financeiro");
    assert.equal(capturedBody.status_filter, "failed");
    assert.deepEqual(capturedBody.cvm_range, { start: 100, end: 999 });
    assert.equal("sector" in capturedBody, false);
    assert.equal("cvm_from" in capturedBody, false);
    assert.equal("cvm_to" in capturedBody, false);
  } finally {
    restore();
  }
});

test("fetchBatchRefresh (web) throws on network failure", async () => {
  const restore = withFetchMock((async () => {
    throw new TypeError("fetch failed");
  }) as FetchMock);

  try {
    await assert.rejects(() => fetchBatchRefresh({ mode: "full" }));
  } finally {
    restore();
  }
});

// ---------------------------------------------------------------------------
// fetchBatchJobStatus — web mode
// ---------------------------------------------------------------------------

test("fetchBatchJobStatus (web) fetches from /api/refresh-jobs/:id", async () => {
  const jobStatus = {
    job_id: "abc123",
    state: "running",
    queued: 10,
    processed: 3,
    failures: 0,
    current_cvm: 9512,
    log_lines: ["Baixando PETROBRAS", "Processando PETROBRAS"],
  };

  let capturedUrl = "";
