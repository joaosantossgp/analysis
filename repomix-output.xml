<file path="apps/web/components/shared/use-combobox-navigation.ts">
"use client";

import { useCallback, useState, type KeyboardEvent } from "react";

type UseComboboxNavigationOptions<T> = {
  items: readonly T[];
  onSelect: (item: T) => void;
  onSubmit?: () => void;
  onEscape?: () => void;
};

type UseComboboxNavigationResult = {
  activeIndex: number;
  setActiveIndex: (index: number) => void;
  handleKeyDown: (event: KeyboardEvent<HTMLInputElement>) => void;
};

type ActiveIndexState<T> = {
  items: readonly T[];
  activeIndex: number;
};

function getInitialActiveIndex(items: readonly unknown[]): number {
  return items.length > 0 ? 0 : -1;
}

function clampActiveIndex(index: number, items: readonly unknown[]): number {
  if (items.length === 0) {
    return -1;
  }
  if (index >= items.length) {
    return items.length - 1;
  }
  return index;
}

export function useComboboxNavigation<T>({
  items,
  onSelect,
  onSubmit,
  onEscape,
}: UseComboboxNavigationOptions<T>): UseComboboxNavigationResult {
  const [activeState, setActiveState] = useState<ActiveIndexState<T>>(() => ({
    items,
    activeIndex: getInitialActiveIndex(items),
  }));
  const activeIndex =
    activeState.items === items
      ? clampActiveIndex(activeState.activeIndex, items)
      : getInitialActiveIndex(items);
  const setActiveIndex = useCallback(
    (nextIndex: number) => {
      setActiveState({ items, activeIndex: nextIndex });
    },
    [items],
  );

  const handleKeyDown = useCallback(
    (event: KeyboardEvent<HTMLInputElement>) => {
      if (event.key === "ArrowDown") {
        if (items.length === 0) return;
        event.preventDefault();
        setActiveState({
          items,
          activeIndex: activeIndex < items.length - 1 ? activeIndex + 1 : 0,
        });
        return;
      }

      if (event.key === "ArrowUp") {
        if (items.length === 0) return;
        event.preventDefault();
        setActiveState({
          items,
          activeIndex: activeIndex > 0 ? activeIndex - 1 : items.length - 1,
        });
        return;
      }

      if (event.key === "Escape") {
        setActiveState({ items, activeIndex: -1 });
        onEscape?.();
        return;
      }

      if (event.key === "Enter") {
        const active = activeIndex >= 0 ? items[activeIndex] : undefined;
        if (active) {
          event.preventDefault();
          onSelect(active);
          return;
        }
        onSubmit?.();
      }
    },
    [items, activeIndex, onSelect, onSubmit, onEscape],
  );

  return { activeIndex, setActiveIndex, handleKeyDown };
}
</file>

<file path="apps/web/components/shared/use-company-suggestions.ts">
"use client";

import { useEffect, useRef, useState } from "react";

import {
  type CompanySuggestionItem,
  fetchCompanySuggestionsRoute,
  getUserFacingErrorMessage,
} from "@/lib/api";

type UseCompanySuggestionsOptions = {
  minLength?: number;
  debounceMs?: number;
  limit?: number;
};

type UseCompanySuggestionsResult = {
  suggestions: CompanySuggestionItem[];
  loading: boolean;
  error: string | null;
};

export function useCompanySuggestions(
  query: string,
  options: UseCompanySuggestionsOptions = {},
): UseCompanySuggestionsResult {
  const { minLength = 2, debounceMs = 250, limit = 6 } = options;

  const [suggestions, setSuggestions] = useState<CompanySuggestionItem[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const cacheRef = useRef(new Map<string, CompanySuggestionItem[]>());

  useEffect(() => {
    const normalized = query.trim();
    if (normalized.length < minLength) {
      setSuggestions([]);
      setLoading(false);
      setError(null);
      return;
    }

    let active = true;
    setLoading(true);
    setError(null);

    const timer = window.setTimeout(async () => {
      try {
        const cached = cacheRef.current.get(normalized);
        if (cached) {
          if (active) setSuggestions(cached);
          return;
        }

        const payload = await fetchCompanySuggestionsRoute(normalized, limit);
        if (!active) return;

        const items = payload.items ?? [];
        cacheRef.current.set(normalized, items);
        setSuggestions(items);
      } catch (err) {
        if (!active) return;
        setSuggestions([]);
        setError(getUserFacingErrorMessage(err));
      } finally {
        if (active) setLoading(false);
      }
    }, debounceMs);

    return () => {
      active = false;
      window.clearTimeout(timer);
    };
  }, [query, minLength, debounceMs, limit]);

  return { suggestions, loading, error };
}
</file>

<file path="apps/web/components/shared/use-desktop-bridge-ready.ts">
"use client";

import { useEffect, useState } from "react";

import { isDesktopMode } from "@/lib/desktop-bridge";

export type DesktopBridgeReadyState = "waiting" | "ready" | "timeout";

const BRIDGE_READY_MAX_ATTEMPTS = 60;
const BRIDGE_READY_RETRY_MS = 100;

export function useDesktopBridgeReady(loadKey: string): DesktopBridgeReadyState {
  const [snapshot, setSnapshot] = useState<{
    loadKey: string;
    state: DesktopBridgeReadyState;
  }>({ loadKey, state: "waiting" });

  useEffect(() => {
    let cancelled = false;
    let timeoutId: ReturnType<typeof setTimeout> | undefined;
    let attempts = 0;

    function checkBridge() {
      if (cancelled) return;

      if (isDesktopMode()) {
        setSnapshot({ loadKey, state: "ready" });
        return;
      }

      attempts += 1;
      if (attempts <= BRIDGE_READY_MAX_ATTEMPTS) {
        timeoutId = setTimeout(checkBridge, BRIDGE_READY_RETRY_MS);
        return;
      }

      setSnapshot({ loadKey, state: "timeout" });
    }

    timeoutId = setTimeout(checkBridge, 0);

    return () => {
      cancelled = true;
      if (timeoutId !== undefined) clearTimeout(timeoutId);
    };
  }, [loadKey]);

  return snapshot.loadKey === loadKey ? snapshot.state : "waiting";
}
</file>

