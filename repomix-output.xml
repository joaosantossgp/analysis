  try {
    await bridgeFetchCompanySuggestions("petro", 5, { readyOnly: true });
    assert.equal(captured.q, "petro");
    assert.equal(captured.limit, 5);
    assert.equal(captured.ready_only, true);
  } finally {
    restore();
  }
