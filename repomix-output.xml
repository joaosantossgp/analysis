                    print(f"    {dt_ini} → {dt_fim} | VL={vl_conta:,.2f} | ORDEM={ordem}")
            else:
                print(f"\n  CD_CONTA={cd_conta}: ❌ NOT FOUND in this file")
    
    except Exception as e:
