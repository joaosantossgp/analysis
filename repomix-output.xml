  stateUpdates: {
    status: 'running',
    context: {
      target_path: targetPath,
      files: fileList,
      language: primaryLanguage,
      framework: detectedFramework,
      total_lines: totalLines,
      file_count: fileCount
    }
  }
};
```

## Output

