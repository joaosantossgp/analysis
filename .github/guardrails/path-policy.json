{
  "_about": "Path-policy enforced by pr-issue-guardrails.yml when a PR carries the 'flow:autonomous' label. See docs/governance/autonomous-mode.md.",
  "laneAllowlists": {
    "frontend": [
      "apps/desktop-web/**"
    ],
    "backend": [
      "apps/api/**",
      "src/**",
      "desktop/**",
      "tests/**",
      "apps/api/tests/**",
      "main.py",
      "requirements.txt",
      "migrations/**"
    ],
    "master": [
      "apps/desktop-web/**",
      "docs/perf/**",
      "apps/api/**",
      "src/**",
      "desktop/**",
      "tests/**",
      "apps/api/tests/**",
      "main.py",
      "requirements.txt",
      "migrations/**"
    ],
    "ops-quality": [
      ".github/**",
      ".claude/launch.json",
      ".claude/settings.json",
      ".claude/agent-context-preferences.json",
      ".claudeignore",
      "docs/**",
      "skills/**",
      "scripts/**",
      "config/**",
      "AGENTS.md",
      "README.md",
      "docs/COMO_RODAR.md",
      "landing/**",
      "pytest.ini",
      "railway.toml",
      ".gitignore",
      ".gdriveignore",
      ".geminiignore",
      "data/test_samples/**"
    ]
  },
  "criticalGroups": [
    {
      "name": "shared-governance",
      "patterns": [
        "AGENTS.md",
        "README.md",
        "docs/COMO_RODAR.md",
        "docs/governance/**",
        ".claude/launch.json",
        ".claude/settings.json",
        ".claude/agent-context-preferences.json",
        ".claudeignore",
        ".github/**",
        "skills/**",
        ".gitignore"
      ],
      "ownerLane": "ops-quality",
      "allowedLanes": [
        "frontend",
        "backend",
        "ops-quality"
      ],
      "minimumRisk": "shared",
      "requireDraft": true,
      "requireCompatibility": false
    },
    {
      "name": "critical-bootstrap",
      "patterns": [
        "scripts/setup/setup_db.py",
        "scripts/setup/setup_companies_table.py",
        "scripts/diagnostics/runtime_doctor.py",
        "scripts/diagnostics/smoke_validate.py",
        "scripts/diagnostics/db_portability_smoke.py"
      ],
      "ownerLane": "ops-quality",
      "allowedLanes": [
        "ops-quality",
        "backend"
      ],
      "minimumRisk": "shared",
      "requireDraft": true,
      "requireCompatibility": false
    },
    {
      "name": "critical-runtime",
      "patterns": [
        "src/settings.py",
        "src/db.py",
        "src/database.py",
        "src/query_layer.py",
        "src/read_service.py",
        "src/refresh_service.py",
        "src/scraper.py",
        "apps/api/app/main.py",
        "apps/api/app/dependencies.py",
        "desktop/app.py",
        "desktop/bridge.py"
      ],
      "ownerLane": "backend",
      "allowedLanes": [
        "backend",
        "master"
      ],
      "minimumRisk": "shared",
      "requireDraft": true,
      "requireCompatibility": false
    },
    {
      "name": "critical-contract",
      "patterns": [
        "apps/api/app/routes/**",
        "apps/api/app/presenters.py",
        "docs/reference/v2-api-contract.md"
      ],
      "ownerLane": "backend",
      "allowedLanes": [
        "backend",
        "master"
      ],
      "minimumRisk": "contract-sensitive",
      "requireDraft": true,
      "requireCompatibility": true
    }
  ],
  "disallowedDomainMixes": [
    {
      "name": "frontend-with-backend-runtime",
      "left": [
        "apps/desktop-web/**"
      ],
      "right": [
        "src/**",
        "apps/api/**",
        "desktop/**"
      ],
      "exemptLanes": [
        "master"
      ]
    }
  ]
}
