# Data files — large raw inputs, databases, caches, dev runtime
data/input/
data/db/
data/cache/
data/metadata/
data/raw/
data/dev-runtime/
data/legacy_archives/

# Build, dist, runtime, and scratch outputs
build/
dist/
output/
tmp/
scratch/
release_validation_*/
repomix-output.*

# Archived/dead scripts and historical docs — do not index by default
archive/
docs/archive/
docs/releases/

# Nested agent worktrees and transient tooling artifacts
.claude/worktrees/
.workflow/.scratchpad/
.playwright-cli/
.playwright-mcp/
.orchestration/

# Stale UI audit reports — reference apps/web (removed) and are not active code
data/reports/

# Reference documents — binary, for human reading only
docs/vendor/

# Python environment and caches
.venv/
__pycache__/
.pytest_cache/

# Node.js
node_modules/

# Binary, logs, and large files
*.xlsx
*.pdf
*.zip
*.db
*.db-wal
*.db-shm
*.sqlite
*.docx
*.log
